# AdventureBox environment. Copy to .env for local dev.
# The app runs fully offline with STUB services and needs NONE of these.

# Toggle real service implementations (default: all stubs).
EXPO_PUBLIC_USE_REAL_AI=false
EXPO_PUBLIC_USE_REAL_AUTH=false
EXPO_PUBLIC_USE_REAL_SYNC=false
EXPO_PUBLIC_USE_REAL_SUBSCRIPTION=false

# OpenRouter is called through a server proxy in production. The raw key is
# NEVER bundled into the app. For local-only experiments you may point the
# proxy URL at a dev endpoint.
EXPO_PUBLIC_AI_PROXY_URL=
EXPO_PUBLIC_AI_MODEL=anthropic/claude-3.5-haiku

# Supabase (only used when EXPO_PUBLIC_USE_REAL_* are true).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (only used when EXPO_PUBLIC_USE_REAL_SUBSCRIPTION=true).
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
EXPO_PUBLIC_RC_ENTITLEMENT=premium
