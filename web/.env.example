# AdventureBox admin CMS environment. Copy to .env.local (never commit real values).
# These are SERVER-ONLY. The service-role key bypasses RLS, so it must never be
# exposed to the browser (no NEXT_PUBLIC_ prefix).

SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Operator gate. ADMIN_PASSWORD is what you type at /login. ADMIN_SESSION_TOKEN is
# a long random string used as the session cookie value (generate one, keep secret).
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TOKEN=generate-a-long-random-string
